@page "/training/historie"
@page "/training/historie/{Id:guid}"
@inject IWorkoutSessionService Sessions
@inject NavigationManager Navigation

<PageTitle>Trainingshistorie / PROJECT MASS</PageTitle>
<div class="page-head"><div><h1>Trainingshistorie</h1></div></div>
<TrainingTabs />
@if (error is not null) { <p class="notice" role="alert">@error</p> }
@if (Id.HasValue)
{
    <a class="section-link" href="training/historie">Alle Trainings</a>
    @if (selected is not null)
    {
        <section class="protocol-section"><div class="section-head"><div><h2>@selected.Name</h2><p class="muted">@selected.Date.ToString("dd.MM.yyyy") / @Sessions.CountSets(selected).Completed / @Sessions.CountSets(selected).Total Sätze erledigt</p></div><button class="small danger" @onclick="() => deleteSession = selected">Löschen</button></div>
            @if (selected.NewPersonalRecords.Count > 0) { <span class="badge record-badge">Neuer PR</span>@foreach(var record in selected.NewPersonalRecords){<p class="mini-label">@record.ExerciseName / @StatisticsLabels.Record(record.Kind): @record.Value.ToString("0.##") @StatisticsLabels.Unit(record.Kind)</p>} }
            @if (!string.IsNullOrWhiteSpace(selected.Note)) { <p class="session-note">@selected.Note</p> }
        </section>
        @foreach (var exercise in selected.Exercises)
        {
            <section class="protocol-section"><h3>@exercise.Name</h3><p class="mini-label">Ziel @exercise.MinReps–@exercise.MaxReps Wdh. / Pause @exercise.RestSeconds s</p>
                <div class="table-wrap"><table><thead><tr><th>Satz</th><th>Typ</th><th>kg</th><th>Wdh.</th><th>RPE</th><th>Status</th></tr></thead><tbody>
                    @for (var i = 0; i < exercise.Sets.Count; i++)
                    {
                        var set = exercise.Sets[i];
                        <tr><td>@(i + 1)</td><td>@TrainingLabels.Set(set.Type)</td><td>@set.WeightKg</td><td>@set.Reps</td><td>@(set.Rpe?.ToString() ?? "—")</td><td>@(set.IsCompleted ? "Erledigt" : "Offen")</td></tr>
                    }
                </tbody></table></div>
            </section>
        }
    }
}
else if (history is not null)
{
    <section class="protocol-section">
        @foreach (var session in history)
        {
            <div class="entry row"><div><a class="section-link" href="@($"training/historie/{session.Id}")"><h3>@session.Name</h3></a><small>@session.Date.ToString("dd.MM.yyyy") / @Sessions.CountSets(session).Completed Sätze erledigt</small>@if(session.NewPersonalRecords.Count > 0){<span class="badge record-badge">Neuer PR</span>}</div><button class="small danger" @onclick="() => deleteSession = session">Löschen</button></div>
        }
        @if (history.Count == 0) { <p class="empty">Noch kein abgeschlossenes Training. Training starten.</p> }
    </section>
}
@if (deleteSession is not null)
{
    <ConfirmationDialog Title="Training löschen?" Message="@($"„{deleteSession.Name}“ vom {deleteSession.Date:dd.MM.yyyy} wird dauerhaft entfernt.")" OnCancel="() => deleteSession = null" OnConfirm="Delete" />
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private List<WorkoutSession>? history;
    private WorkoutSession? selected;
    private WorkoutSession? deleteSession;
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        error = null; selected = null;
        try
        {
            if (Id.HasValue)
            {
                selected = await Sessions.GetAsync(Id.Value);
                if (selected?.IsCompleted != true) { selected = null; error = "Abgeschlossenes Training nicht gefunden."; }
            }
            else history = await Sessions.GetHistoryAsync();
        }
        catch (Exception) { error = "Die Historie konnte nicht geladen werden."; }
    }
    private async Task Delete()
    {
        try
        {
            await Sessions.DeleteAsync(deleteSession!.Id); deleteSession = null;
            if (Id.HasValue) Navigation.NavigateTo("training/historie");
            else history = await Sessions.GetHistoryAsync();
        }
        catch (Exception) { error = "Das Training konnte nicht gelöscht werden."; deleteSession = null; }
    }
}
