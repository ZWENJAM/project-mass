@page "/training"
@inject IWorkoutPlanService Plans
@inject IWorkoutSessionService Sessions
@inject NavigationManager Navigation

<PageTitle>Training / PROJECT MASS</PageTitle>
<div class="page-head"><div><h1>Trainingspläne</h1></div><a class="button-link primary" href="training/plaene/neu">+ Plan</a></div>
<TrainingTabs />
@if (error is not null) { <p class="notice" role="alert">@error</p> }
@if (draft is not null)
{
    <section class="protocol-section draft-banner"><div><span class="badge warning-badge">Offenes Training</span><h2>@draft.Name</h2><p class="muted">@draft.Date.ToString("dd.MM.yyyy") / Dein Entwurf ist gespeichert.</p></div><a class="button-link primary" href="@($"training/live/{draft.Id}")">Fortsetzen</a></section>
}
@if (plans is null) { <p role="status">Trainingspläne werden geladen …</p> }
else if (plans.Count == 0) { <p class="protocol-section empty">Noch keine Pläne. Lege deinen ersten Trainingsplan an.</p> }
else
{
    <div class="section-list">
        @foreach (var plan in plans)
        {
            <section class="protocol-section plan-card" @key="plan.Id">
                <div class="section-head"><h2>@plan.Name</h2><span class="badge">@TrainingLabels.Day(plan.Day)</span></div>
                <p class="mini-label">@plan.Exercises.Count Übungen</p>
                @if (!string.IsNullOrWhiteSpace(plan.Note)) { <p class="muted plan-note">@plan.Note.Replace(" · ", ", ")</p> }
                <div class="training-actions">
                    <button class="primary" disabled="@busy" @onclick="() => Start(plan.Id)">@(draft is null ? "Training starten" : "Training fortsetzen")</button>
                    <a class="section-link" href="@($"training/plaene/{plan.Id}")">Bearbeiten</a>
                </div>
            </section>
        }
    </div>
}

@code {
    private List<WorkoutPlan>? plans;
    private WorkoutSession? draft;
    private string? error;
    private bool busy;
    protected override async Task OnInitializedAsync()
    {
        try { plans = await Plans.GetAllAsync(); draft = await Sessions.GetDraftAsync(); }
        catch (Exception) { error = "Trainingsdaten konnten nicht geladen werden. Bitte die Seite neu laden."; }
    }
    private async Task Start(Guid id)
    {
        if (busy) return;
        busy = true; error = null;
        try { var session = await Sessions.StartAsync(id); Navigation.NavigateTo($"training/live/{session.Id}"); }
        catch (Exception) { error = "Das Training konnte nicht gestartet werden. Bitte erneut versuchen."; }
        finally { busy = false; }
    }
}
