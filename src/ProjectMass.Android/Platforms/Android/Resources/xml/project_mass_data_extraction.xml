<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" path="app_webview/" />
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
