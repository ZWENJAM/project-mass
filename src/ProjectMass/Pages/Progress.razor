@page "/fortschritt"
@inject IMeasurementService Measurements
@inject IWorkoutSessionService Sessions
@inject IExerciseService Exercises
@inject IProfileService Profiles
@inject IStorageService Storage
@inject IStatisticsService Statistics
<PageTitle>Fortschritt / PROJECT MASS</PageTitle>
<div class="page-head"><div><h1>Fortschritt</h1></div><button class="primary" @onclick="NewMeasurement">+ Messung</button></div>
@if (error is not null) { <p class="notice" role="alert">@error</p> }
@if (editing is not null)
{
    <EditForm Model="editing" OnSubmit="Save" FormName="measurement">
        <fieldset class="editor-fields" disabled="@busy"><section class="protocol-section"><h2>Messung erfassen / bearbeiten</h2><div class="form-grid">
            <label class="field">Messdatum<input type="date" @bind="editing.Date" /></label>
            <label class="field">Gewicht (kg)<input type="number" min="0.01" step="any" @bind="editing.WeightKg" @bind:event="oninput" /></label>
            <label class="field">Bauch (cm)<input type="number" min="0.01" step="any" @bind="editing.WaistCm" @bind:event="oninput" /></label>
            <label class="field">Brust (cm)<input type="number" min="0.01" step="any" @bind="editing.ChestCm" @bind:event="oninput" /></label>
            <label class="field">Oberarm (cm)<input type="number" min="0.01" step="any" @bind="editing.UpperArmCm" @bind:event="oninput" /></label>
            <label class="field">KFA (%)<input type="number" min="0.01" max="100" step="any" @bind="editing.BodyFatPercent" @bind:event="oninput" /></label>
        </div><p class="mini-label">Mindestens ein Wert ist erforderlich. Nicht gemessene Werte bleiben leer.</p><div class="form-actions"><button type="button" @onclick="() => editing = null">Abbrechen</button><button type="submit" class="primary">Messung speichern</button></div></section></fieldset>
    </EditForm>
}
<section class="protocol-section"><h2>Messverlauf</h2><label class="field">Messwert<select @bind="metric"><option value="weight">Gewicht</option><option value="waist">Bauch</option><option value="chest">Brust</option><option value="arm">Oberarm</option><option value="fat">KFA</option></select></label>
    <LineChart Points="Points" Average="@(metric == "weight" ? Statistics.MovingAverage(Points) : [])" Label="Körperverlauf" Unit="@(metric == "weight" ? "kg" : metric == "fat" ? "%" : "cm")" />
</section>
<div class="section-title"><h2>Alle Messungen</h2></div>
<section class="protocol-section table-wrap">
    @if (measurements.Count == 0) { <p class="empty">Noch keine Messung. Gewicht eintragen.</p> }
    else { <table><thead><tr><th>Datum</th><th>Gewicht kg</th><th>Bauch cm</th><th>Brust cm</th><th>Oberarm cm</th><th>KFA %</th><th>Aktion</th></tr></thead><tbody>
        @foreach(var m in measurements){<tr><td>@m.Date.ToString("dd.MM.yyyy")</td><td>@StatisticsLabels.Value(m.WeightKg)</td><td>@StatisticsLabels.Value(m.WaistCm)</td><td>@StatisticsLabels.Value(m.ChestCm)</td><td>@StatisticsLabels.Value(m.UpperArmCm)</td><td>@StatisticsLabels.Value(m.BodyFatPercent)</td><td><button class="small" @onclick="() => Edit(m)">Bearbeiten</button> <button class="small danger" @onclick="() => deleting = m">Löschen</button></td></tr>}
    </tbody></table> }
</section>
<div class="section-title"><h2>Trainingsfrequenz</h2></div>
<section class="protocol-section"><FrequencyCalendar Days="Statistics.GetFrequency(history, today)" Today="today" /><p class="mini-label">Streak: @Statistics.GetStreak(history, profile.TrainingDaysPerWeek, today) Wochen / Wochenziel: @profile.TrainingDaysPerWeek Trainings. Die laufende Woche zählt erst beim Erreichen des Ziels.</p></section>
<div class="section-title"><h2>Wochenbericht</h2></div>
<div class="date-navigation"><button aria-label="Vorherige Woche" @onclick="() => ChangeWeek(-7)"><AppIcon Name="previous" /></button><label>Woche auswählen<input type="date" @bind="week" @bind:after="UpdateWeek" /></label><button aria-label="Nächste Woche" @onclick="() => ChangeWeek(7)"><AppIcon Name="next" /></button></div>
@if (report is not null)
{
    <p class="mini-label">@report.WeekStart.ToString("dd.MM.yyyy") – @report.WeekStart.AddDays(6).ToString("dd.MM.yyyy") / @report.LoggedDays Tage mit Ernährungseinträgen</p>
    <div class="summary-ledger">
        <section class="protocol-section stat"><span class="label">Ø Kalorien</span><h2>@StatisticsLabels.Value(report.AverageKcal, "kcal")</h2><p class="mini-label">Ziel @profile.TargetKcal.ToString("0.#") kcal / Tag</p></section>
        <section class="protocol-section stat"><span class="label">Ø Protein</span><h2>@StatisticsLabels.Value(report.AverageProtein, "g")</h2><p class="mini-label">Ziel @profile.TargetProteinGrams.ToString("0.#") g / Tag</p></section>
        <section class="protocol-section stat"><span class="label">Gewichtstrend</span><h2>@StatisticsLabels.Value(report.WeightChange, "kg")</h2><p class="mini-label">Ø @StatisticsLabels.Value(report.AverageWeight, "kg") vs. Vorwoche @StatisticsLabels.Value(report.PreviousAverageWeight, "kg")</p></section>
        <section class="protocol-section stat"><span class="label">Training</span><h2>@report.Trainings Einheiten</h2><p class="mini-label">@report.TotalVolumeKg.ToString("0.#") kg Gesamtvolumen</p></section>
    </div>
    <section class="protocol-section"><h2>Volumen nach Muskelgruppe</h2><p class="mini-label">Abgeschlossene Arbeitssätze / kg × Wdh. / Mehrere Muskelgruppen zählen jeweils voll. Im Gesamtvolumen wird jeder Satz einmal gezählt.</p>
        @if(volumes.Count == 0){<p class="empty">Noch keine abgeschlossenen Arbeitssätze in dieser Woche.</p>}
        else {<div class="table-wrap"><table><thead><tr><th>Muskelgruppe</th><th>Volumen kg</th><th>Arbeitssätze</th></tr></thead><tbody>@foreach(var volume in volumes){<tr><td>@volume.MuscleGroup</td><td>@volume.VolumeKg.ToString("0.#")</td><td>@volume.WorkingSets</td></tr>}</tbody></table></div>}
    </section>
}
<div class="section-title"><h2>Persönliche Rekorde</h2></div>
<section class="protocol-section">
    @if(records.Count == 0){<p class="empty">Noch keine Rekorde. Ein Training abschließen.</p>}
    @foreach(var group in records.GroupBy(r => r.ExerciseId)){
        <article class="entry"><h3>@group.First().ExerciseName</h3>@foreach(var record in group){<p class="mini-label">@StatisticsLabels.Record(record.Kind): <strong>@record.Value.ToString("0.##") @StatisticsLabels.Unit(record.Kind)</strong> / @record.Date.ToString("dd.MM.yyyy")</p>}</article>
    }
</section>
@if (deleting is not null) { <ConfirmationDialog Title="Messung löschen?" Message="@($"Die Messung vom {deleting.Date:dd.MM.yyyy} wird entfernt.")" OnCancel="() => deleting = null" OnConfirm="Delete" /> }
@code {
    private List<BodyMeasurement> measurements = [];
    private List<WorkoutSession> history = [];
    private List<Exercise> catalog = [];
    private List<FoodLogEntry> logs = [];
    private List<PersonalRecord> records = [];
    private List<MuscleVolume> volumes = [];
    private UserProfile profile = new();
    private WeeklyReport? report;
    private BodyMeasurement? editing, deleting;
    private DateOnly today = DateOnly.FromDateTime(DateTime.Today), week;
    private string metric = "weight";
    private string? error;
    private bool busy;
    private List<ChartPoint> Points => measurements.Select(m => new { m.Date, Value = metric switch { "waist" => m.WaistCm, "chest" => m.ChestCm, "arm" => m.UpperArmCm, "fat" => m.BodyFatPercent, _ => m.WeightKg } }).Where(m => m.Value.HasValue).OrderBy(m => m.Date).Select(m => new ChartPoint(m.Date, m.Value!.Value)).ToList();
    protected override async Task OnInitializedAsync() { week = Statistics.WeekStart(today); await Load(); }
    private async Task Load()
    {
        try {
            measurements = await Measurements.GetAllAsync(); history = await Sessions.GetHistoryAsync(); catalog = await Exercises.GetAllAsync(); profile = await Profiles.GetAsync();
            logs = await Storage.GetAllAsync<FoodLogEntry>(StorageStores.FoodLogEntries);
            records = Statistics.GetPersonalRecords(history); UpdateWeek();
        }
        catch { error = "Fortschrittsdaten konnten nicht geladen werden."; }
    }
    private void NewMeasurement() { editing = new(); error = null; }
    private void Edit(BodyMeasurement measurement) { editing = System.Text.Json.JsonSerializer.Deserialize<BodyMeasurement>(System.Text.Json.JsonSerializer.Serialize(measurement)); error = null; }
    private void ChangeWeek(int days) { week = week.AddDays(days); UpdateWeek(); }
    private void UpdateWeek() { week = Statistics.WeekStart(week); report = Statistics.GetWeeklyReport(week, logs, measurements, history); volumes = Statistics.GetMuscleVolume(history, catalog, week); }
    private async Task Save(EditContext context)
    {
        if (!context.Validate() || busy) return; busy = true; error = null;
        try { await Measurements.SaveAsync(editing!); editing = null; await Load(); }
        catch(ArgumentException ex){error = ex.Message;}
        catch { error = "Messung konnte nicht gespeichert werden."; }
        finally { busy = false; }
    }
    private async Task Delete()
    {
        try { await Measurements.DeleteAsync(deleting!.Id); deleting = null; await Load(); }
        catch { error = "Messung konnte nicht gelöscht werden."; deleting = null; }
    }
}
