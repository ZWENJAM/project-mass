@page "/ernaehrung/eintrag"
@page "/ernaehrung/eintrag/{Id:guid}"
@inject INutritionService Nutrition
@inject INutritionCalculator Calculator
@inject NavigationManager Navigation
<PageTitle>@Title / PROJECT MASS</PageTitle>
<div class="page-content narrow log-editor">
<div class="entry-head">
    <a class="icon-button" href="@BackUrl" aria-label="Zurück zum Tageslog"><AppIcon Name="previous" /></a>
    <div><h1>@Title</h1><p class="mini-label">@date.ToString("dddd, d. MMMM", German)</p></div>
</div>
@if (error is not null) { <p class="notice" role="alert">@error</p> }
@if (ready)
{
    @if (!Id.HasValue && selected is null)
    {
        <FoodSearchPanel OnSelected="Select" />
    }
    else if (entry?.IsQuickEntry == true)
    {
        <form class="amount-sheet" @onsubmit="SaveQuick" @onsubmit:preventDefault>
            <fieldset class="editor-fields" disabled="@busy">
                <MealPicker Value="meal" ValueChanged="v => meal = v" />
                <label class="field">Name (optional)<input @bind="quickName" maxlength="120" placeholder="z. B. Döner" /></label>
                <div class="form-grid">
                    <label class="field">Kalorien (kcal)<input type="number" inputmode="decimal" required min="0" max="100000" step="any" @bind="quickKcal" /></label>
                    <label class="field">Protein (g)<input type="number" inputmode="decimal" required min="0" max="10000" step="any" @bind="quickProtein" /></label>
                </div>
                <details class="date-details"><summary>Datum ändern</summary><label class="field">Datum<input type="date" @bind="date" /></label></details>
                <button class="primary add-button" type="submit">Speichern</button>
            </fieldset>
        </form>
    }
    else if (selected is not null)
    {
        <EditForm Model="selected" OnSubmit="Save" FormName="food-log" class="amount-sheet">
            <fieldset class="editor-fields" disabled="@busy">
                <div class="amount-food">
                    <FoodThumb Food="selected" />
                    <div class="amount-food-text"><h2>@selected.Name</h2><p class="mini-label">@(string.IsNullOrWhiteSpace(selected.Brand) ? "" : selected.Brand + ", ")@selected.NutrientsPer100G.Kcal.ToString("0", German) kcal pro 100 g</p></div>
                    @if (!Id.HasValue) { <button type="button" class="small" @onclick="() => selected = null">Ändern</button> }
                </div>
                @if (!string.IsNullOrWhiteSpace(selected.Note) && Id.HasValue) { <p class="mini-label">@selected.Note</p> }

                <MealPicker Value="meal" ValueChanged="v => meal = v" />

                <div class="amount-field">
                    <span class="amount-label" id="amount-label">Menge</span>
                    <div class="amount-row">
                        <button type="button" class="amount-step" aria-label="Weniger" @onclick="() => StepAmount(-1)">−</button>
                        <div class="amount-value"><input type="number" inputmode="decimal" min="0.01" step="any" aria-labelledby="amount-label" @bind="quantity" @bind:event="oninput" /><span>@UnitLabel</span></div>
                        <button type="button" class="amount-step" aria-label="Mehr" @onclick="() => StepAmount(1)">+</button>
                    </div>
                    <div class="portion-chips" role="group" aria-label="Einheit">
                        <button type="button" class="chip @(unit == "grams" ? "active" : "")" aria-pressed="@(unit == "grams")" @onclick="@(() => SetUnit("grams"))">Gramm</button>
                        @for (var i = 0; i < selected.PortionSizes.Count; i++)
                        {
                            var key = i.ToString(System.Globalization.CultureInfo.InvariantCulture);
                            var portion = selected.PortionSizes[i];
                            <button type="button" class="chip @(unit == key ? "active" : "")" aria-pressed="@(unit == key)" @onclick="() => SetUnit(key)">@portion.Name (@portion.Grams.ToString("0.#", German) g)</button>
                        }
                    </div>
                </div>

                <dl class="macro-preview">
                    <div class="macro-kcal"><dt>Kalorien</dt><dd>@Preview.Kcal.ToString("0", German) <span>kcal</span></dd></div>
                    <div><dt>Protein</dt><dd>@Preview.ProteinGrams.ToString("0.#", German) <span>g</span></dd></div>
                    <div><dt>KH</dt><dd>@Preview.CarbohydrateGrams.ToString("0.#", German) <span>g</span></dd></div>
                    <div><dt>Fett</dt><dd>@Preview.FatGrams.ToString("0.#", German) <span>g</span></dd></div>
                </dl>
                @if (unit != "grams") { <p class="mini-label">Entspricht @Grams.ToString("0.#", German) g.</p> }

                <details class="date-details"><summary>Datum ändern</summary><label class="field">Datum<input type="date" @bind="date" /></label></details>
                <button class="primary add-button" type="submit">@(Id.HasValue ? "Speichern" : "Hinzufügen")</button>
            </fieldset>
        </EditForm>
    }
}
</div>
@code {
    private static readonly System.Globalization.CultureInfo German = System.Globalization.CultureInfo.GetCultureInfo("de-DE");
    private string Title => Id.HasValue ? "Eintrag bearbeiten" : "Essen eintragen";
    private string UnitLabel => unit == "grams" ? "g" : quantity == 1 ? "Portion" : "Portionen";

    private void SetUnit(string next) { unit = next; quantity = next == "grams" ? 100 : 1; }

    // Grams move in 10er steps, portions in halves.
    private void StepAmount(int direction)
    {
        var step = unit == "grams" ? 10m : 0.5m;
        quantity = Math.Max(unit == "grams" ? 0 : 0.5m, Math.Round((quantity + step * direction) / step) * step);
    }

    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "datum")] public string? Datum { get; set; }
    [SupplyParameterFromQuery(Name = "mahlzeit")] public int? Mahlzeit { get; set; }
    private FoodItem? selected;
    private FoodLogEntry? entry;
    private string unit = "grams";
    private string? error;
    private bool busy, ready;
    private DateOnly date = DateOnly.FromDateTime(DateTime.Today);
    private MealType meal;
    private decimal quantity = 100;
    private string? quickName;
    private decimal? quickKcal, quickProtein;
    private string BackUrl => $"ernaehrung?datum={date:yyyy-MM-dd}";
    private decimal Grams => quantity <= 0 ? 0 : unit == "grams" ? quantity : Nutrition.PortionGrams(selected!.PortionSizes[int.Parse(unit)], quantity);
    private Nutrients Preview => Calculator.ForAmount(selected!.NutrientsPer100G, Grams);
    protected override async Task OnParametersSetAsync()
    {
        ready = false; error = null;
        try {
            if (Id.HasValue)
            {
                entry = await Nutrition.GetAsync(Id.Value);
                if (entry is null) { error = "Eintrag nicht gefunden."; return; }
                selected = entry.FoodSnapshot; date = entry.Date; meal = entry.Meal; quantity = entry.AmountGrams;
                if (entry.IsQuickEntry)
                {
                    quickName = selected.Name;
                    quickKcal = selected.NutrientsPer100G.Kcal;
                    quickProtein = selected.NutrientsPer100G.ProteinGrams;
                }
            }
            else
            {
                entry = null; selected = null;
                date = DateOnly.TryParse(Datum, out var d) ? d : DateOnly.FromDateTime(DateTime.Today);
                meal = Mahlzeit is >= 0 and <= 3 ? (MealType)Mahlzeit.Value : MealType.Breakfast;
            }
            unit = "grams"; ready = true;
        }
        catch { error = "Der Eintrag konnte nicht geladen werden."; }
    }
    private void Select(FoodItem food) { selected = food; unit = "grams"; quantity = 100; }
    private void UnitChanged() { quantity = unit == "grams" ? 100 : 1; }
    private async Task SaveQuick()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            await Nutrition.SaveQuickEntryAsync(date, meal, quickName, quickKcal, quickProtein, entry!.Id);
            Navigation.NavigateTo(BackUrl);
        }
        catch (ArgumentException ex) { error = ex.Message; }
        catch { error = "Speichern fehlgeschlagen. Bitte erneut versuchen."; }
        finally { busy = false; }
    }
    private async Task Save(EditContext context)
    {
        if (!context.Validate() || busy) return;
        busy = true; error = null;
        try {
            if (entry is not null) { entry.Date = date; entry.Meal = meal; entry.AmountGrams = Grams; await Nutrition.UpdateAsync(entry); }
            else await Nutrition.AddAsync(date, meal, selected!.Id, Grams);
            Navigation.NavigateTo(BackUrl);
        }
        catch (ArgumentException ex) { error = ex.Message; }
        catch { error = "Speichern fehlgeschlagen. Bitte erneut versuchen."; }
        finally { busy = false; }
    }
}
